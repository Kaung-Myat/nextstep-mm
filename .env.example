DATABASE_URL="postgresql://user:password@localhost:5432/nextstep_mm?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/nextstep_mm?schema=public"

# Job crawl / skill extraction (Settings "Crawl now" + `npm run jobs:ingest`)
# OpenRouter is the default provider (recommended for Myanmar; direct Gemini may be geo-blocked).
INGEST_AI_ENABLED=true
INGEST_AI_PROVIDER=openrouter
INGEST_AI_MODEL=openrouter/free
# INGEST_AI_API_KEY=
OPENROUTER_API_KEY=
# GEMINI_API_KEY=
INGEST_LIMIT=8

# Optional: require `x-crawl-secret` for non-browser crawl clients.
# Same-origin Settings UI still works without sending this header.
# CRAWL_SECRET=

# Signed anonymous session cookies (HMAC). Recommended in production.
# SESSION_SECRET=

# Distributed API rate limits (Upstash Redis). Falls back to in-memory when unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
