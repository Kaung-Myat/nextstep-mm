generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserLevel {
  BEGINNER
  INTERMEDIATE
  JOB_READY
}

enum LearningPath {
  FRONTEND
  BACKEND
  FULLSTACK
}

enum JobLevel {
  INTERN
  JUNIOR
}

enum JobType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  name                   String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  profile                UserProfile?
  roadmapProgress        RoadmapProgress[]
  internshipPrepProgress InternshipPrepProgress[]
}

model UserProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  targetRole       LearningPath?
  currentLevel     UserLevel?
  universityYear   Int?
  internshipGoalAt DateTime?
  interestedStack  String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String
  audience    String           @default("")
  path        LearningPath     @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sections    RoadmapSection[]
}

model RoadmapSection {
  id          String        @id @default(cuid())
  roadmapId   String
  slug        String
  title       String
  description String        @default("")
  stage       UserLevel
  sortOrder   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  roadmap     Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  items       RoadmapItem[]

  @@unique([roadmapId, sortOrder])
  @@unique([roadmapId, slug])
  @@index([roadmapId, stage])
}

model RoadmapItem {
  id              String            @id @default(cuid())
  sectionId       String
  slug            String
  title           String
  description     String
  difficulty      String            @default("beginner")
  whyItMatters    String?
  expectedOutcome String?
  miniProjects    Json              @default("[]")
  commonMistakes  Json              @default("[]")
  nextTopic       String?
  resourceLinks   Json?
  sortOrder       Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  section         RoadmapSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress        RoadmapProgress[]

  @@unique([sectionId, slug])
  @@unique([sectionId, sortOrder])
}

model RoadmapProgress {
  id            String      @id @default(cuid())
  userId        String
  roadmapItemId String
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapItem   RoadmapItem @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapItemId])
  @@index([roadmapItemId])
}

model InternshipPrepProgress {
  id          String    @id @default(cuid())
  userId      String
  itemKey     String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}

model AppContent {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  category  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  jobSkills JobSkill[]
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  location  String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
}

model Job {
  id                    String     @id @default(cuid())
  companyId             String
  title                 String
  sourceUrl             String     @unique
  sourceName            String
  location              String?
  level                 JobLevel?
  jobType               JobType
  status                JobStatus  @default(PENDING)
  reviewNote            String?
  reviewedAt            DateTime?
  rawDescription        String
  normalizedDescription String?
  postedAt              DateTime?
  lastCheckedAt         DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  company               Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  skills                JobSkill[]

  @@index([companyId])
  @@index([level, jobType])
  @@index([status, createdAt])
  @@index([status, postedAt, createdAt])
  @@index([postedAt])
}

model JobSkill {
  id        String   @id @default(cuid())
  jobId     String
  skillId   String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
}
